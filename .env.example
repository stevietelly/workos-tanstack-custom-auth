# Database (Neon Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# WorkOS (server-side — keep these secret)
WORKOS_API_KEY=sk_test_xxx
WORKOS_CLIENT_ID=client_xxx
WORKOS_COOKIE_PASSWORD=use-a-random-32+-char-string-here-please
# Optional: pin the OAuth callback URI (defaults to the request host)
# WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback

# WorkOS (client-side — exposed to the browser, VITE_ prefix required)
VITE_WORKOS_CLIENT_ID=client_xxx
VITE_WORKOS_API_HOSTNAME=api.workos.com

# Paystack (KES + USD plans per tier)
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PRO_KES_PLAN=PLAN_pro_kes_xxx
PAYSTACK_PRO_USD_PLAN=PLAN_pro_usd_xxx
PAYSTACK_ENT_KES_PLAN=PLAN_ent_kes_xxx
PAYSTACK_ENT_USD_PLAN=PLAN_ent_usd_xxx

# Cron — used to protect /api/cron/cleanup
CRON_SECRET=set-a-random-string-here

# App
VITE_APP_TITLE=geliana hooks
